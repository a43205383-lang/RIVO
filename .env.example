# URL del proyecto Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública anon/publishable (Project Settings → API Keys; anon legacy o sb_publishable_)
# Es seguro exponerla: la seguridad real vive en RLS y Storage Policies.
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Opcional: límite de fotos por gasto mostrado en la interfaz (1–5)
VITE_MAX_IMAGES_PER_EXPENSE=5

# ---------------------------------------------------------------------------
# Solo para el script de usuarios de prueba (npm run seed:demo).
# NUNCA las uses en variables VITE_*: Vite las incluiría en el bundle.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# DEMO_EMPLOYEE_EMAIL=empleado@rivo.demo
# DEMO_EMPLOYEE_PASSWORD=Empleado1234!
# DEMO_ACCOUNTANT_EMAIL=contador@rivo.demo
# DEMO_ACCOUNTANT_PASSWORD=Contador1234!
